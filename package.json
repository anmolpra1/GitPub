{
  "name": "gitpub-monorepo",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "api:dev": "npm run dev --prefix services/api",
    "api:check": "cmd /c \"cd services\\api && npx tsc --noEmit\"",
    "gateway:dev": "cmd /c \"cd services\\gateway && go run cmd\\server\\main.go\"",
    "gateway:build": "cmd /c \"cd services\\gateway && go build -o bin\\gateway.exe cmd\\server\\main.go\"",
    "web:dev": "npm run dev --prefix apps/web",
    "web:build": "npm run build --prefix apps/web",
    "web:check": "cmd /c \"cd apps\\web && npx tsc --noEmit\"",
    "test:smoke": "node scripts/e2e_verify.js"
  },
  "dependencies": {
    "do": "^0.7.1",
    "dotenv": "^17.4.2"
  }
}
